{
  "name": "visa-one",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Visa One - student concept prototype (Group K, LSE MG481 Sprint Week)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "test:all": "vitest run && vitest run -c vitest.e2e.config.ts",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "diagnose": "node e2e/diagnose.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "framer-motion": "^14.9.1",
    "lucide-react": "^1.69.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.14.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.64.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
